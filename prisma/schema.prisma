generator client {
provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model categorias {
  id        Int         @id @default(autoincrement())
  nombre    String      @db.VarChar(100)
  productos productos[]
}

model productos {
  id           Int        @id @default(autoincrement())
  nombre       String     @db.VarChar(100)
  descripcion  String     @db.VarChar(255)
  imagen       String     @db.VarChar(255)
  precio       Decimal    @db.Decimal(10, 2)
  contiene     String     @db.Text
  categoria_id Int
  categorias   categorias @relation(fields: [categoria_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "productos_ibfk_1")

  @@index([categoria_id], map: "categoria_id")
}
